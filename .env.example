# =============================================================================
# TaxiHUB — Variables de Entorno de Producción / Staging (.env)
# =============================================================================
# Este archivo sirve de plantilla. En el servidor VPS, copie este archivo a .env
# y configure contraseñas seguras y claves criptográficas únicas.
# NUNCA suba el archivo .env con valores reales a repositorios públicos.

# --- Entorno de Ejecución ---
ENV=production

# --- PostgreSQL (Infraestructura Nexium) ---
POSTGRES_USER=taxihub
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_POSTGRES
POSTGRES_DB=taxihub
DATABASE_URL=postgresql+asyncpg://taxihub:CAMBIAR_POR_PASSWORD_SEGURO_POSTGRES@nexium-postgres:5432/taxihub

# --- MongoDB (Motor de Despacho en Tiempo Real) ---
MONGO_URL=mongodb://taxihub-mongo:27017
DB_NAME=taxihub_prod

# --- Seguridad y Autenticación JWT ---
JWT_SECRET=CAMBIAR_POR_TOKEN_CRIPTOGRAFICO_HEX_64_CHARS

# --- Panel de Desarrollador (/dev) ---
DEV_USER=admin
DEV_PASSWORD=CAMBIAR_POR_PASSWORD_PANEL_DEV

# --- Orígenes Permitidos CORS ---
CORS_ORIGINS=https://taxihub.cloud,https://www.taxihub.cloud
