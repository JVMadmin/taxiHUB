{
  "appId": "com.taxihub.socio",
  "appName": "TaxiHUB Socios",
  "webDir": "build",
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "appStartPath": "/dueno"
  },
  "plugins": {
    "LocalNotifications": {
      "iconColor": "#F59E0B"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B0D10"
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true
  }
}
